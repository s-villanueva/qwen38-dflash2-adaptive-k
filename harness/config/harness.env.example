# Copy to harness.env; this file is intentionally ignored by Git.
# Use an isolated OpenAI-compatible experimental endpoint on the same host.
export QWEN_HARNESS_BASE_URL='http://127.0.0.1:8001/v1'
export QWEN_HARNESS_MODEL='your-experimental-model-name'

# Pinned upstream dependency prepared by scripts/bootstrap_gvs5h.sh.
export GVS5H_ESCALATION_DIR='/opt/gvs5h/codebase/v2-current/escalation'

# Bounded orchestration. Start with one or two active workspaces.
export QWEN_HARNESS_MAX_ITERS=3
export QWEN_HARNESS_MAX_TASKS=8
export QWEN_HARNESS_MAX_TOKENS=2048
export QWEN_HARNESS_MAX_ACTIVE=2
export QWEN_HARNESS_TIMEOUT_SECONDS=1800

# Request-scoped only. Keep the server default unchanged for normal API users.
export QWEN_HARNESS_CHAT_TEMPLATE_KWARGS='{"enable_thinking": false}'
